+                try:
+                    return await anyio.to_thread.run_sync(functools.partial(fn, *fn_args, **fn_kwargs))
+                except ToolError:
+                    raise
+                except Exception as e:
+                    # MCPServer only passes a ToolError's message to the client; the tools'
+                    # error messages (GIMP not running, invalid values) are meant for it.
+                    raise ToolError(str(e)) from e
         return register(run)
     return decorator
 
